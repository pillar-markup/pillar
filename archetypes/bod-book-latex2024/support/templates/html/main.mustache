<!DOCTYPE html>
<html lang="en"{{#palette}} data-palette="{{.}}"{{/palette}}{{#theme}} data-theme="{{.}}"{{/theme}}>
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>{{site_name}}</title>
  <meta name="description" content="{{description}}">
  {{#attribution}}<meta name="author" content="{{.}}">{{/attribution}}
  <link rel="stylesheet" href="_support/html/css/book.css">
</head>
<body>
  <a class="skip-link" href="#content">Skip to the text</a>

  <header class="site-header">
    <a class="site-name" href="index.html">{{site_name}}</a>
  </header>

  <div class="layout">
    {{#toc}}
    <nav class="toc" aria-label="Table of contents">
      <details open>
        <summary>Contents</summary>
        <ol>
          {{#children}}
          <li>
            <a href="{{href}}">{{name}}</a>
            {{#hasChildren}}
            <ol>
              {{#children}}
              <li><a href="{{href}}">{{name}}</a></li>
              {{/children}}
            </ol>
            {{/hasChildren}}
          </li>
          {{/children}}
        </ol>
      </details>
    </nav>
    {{/toc}}

    <main id="content" class="page">
      {{{content}}}
    </main>
  </div>

  <footer class="site-footer">
    <p>{{site_name}}{{#attribution}} · {{.}}{{/attribution}}</p>
  </footer>
</body>
</html>
